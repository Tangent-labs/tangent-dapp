{
  "name": "tangent-dapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev ",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:tscold": "npx tsc --noEmit  --jsx preserve  --skipLibCheck  --excludeDirectories _utils --resolveJsonModule",
    "lint:tsc": "npx tsc --noEmit",
    "lint:prettier": "prettier --check .",
    "lintfix": "prettier --write --list-different . ",
    "prepare": "husky",
    "helper:build-token-tstype": "node ./_utils/create_tokens_ts_type.js",
    "validate": "npm run lint && npm run lint:tsc"
  },
  "dependencies": {
    "add": "^2.0.6",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "next": "^15.0.0-canary.165",
    "prettier": "^3.3.3",
    "react": "19.0.0-rc-a99d8e8d-20240916",
    "react-dom": "19.0.0-rc-a99d8e8d-20240916"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.0.0-canary.159",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}